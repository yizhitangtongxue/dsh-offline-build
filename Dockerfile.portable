# syntax=docker/dockerfile:1

FROM node:22-bullseye AS builder

ARG TARGETARCH
ARG DSH_VERSION=0.1.1-rc.2
ARG DSH_WEBUI_VERSION=0.2.7

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential python3 git ca-certificates curl file \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

WORKDIR /build/bundle/runtime
COPY payload/runtime-package.json ./package.json
COPY payload/runtime-pnpm-workspace.yaml ./pnpm-workspace.yaml
RUN pnpm install --prod --frozen-lockfile=false --config.minimum-release-age=0

WORKDIR /build
RUN mkdir -p bundle/dsh-home bundle/bin bundle/offline-plugins
COPY payload/start.sh bundle/start.sh
COPY payload/install-plugin-offline.sh bundle/install-plugin-offline.sh
COPY payload/verify.sh bundle/verify.sh
COPY payload/README-OFFLINE.md bundle/README.md
COPY payload/pnpm-wrapper.sh bundle/bin/pnpm
RUN cp -L "$(command -v node)" bundle/bin/node \
    && chmod +x bundle/start.sh bundle/install-plugin-offline.sh bundle/verify.sh bundle/bin/node bundle/bin/pnpm

ENV DSH_HOME=/build/bundle/dsh-home
ENV PATH=/build/bundle/bin:/opt/dsh/runtime/node_modules/.bin:${PATH}
COPY docker/extra-plugins.txt /tmp/extra-plugins.txt

RUN set -eux; \
    CLI=/build/bundle/runtime/node_modules/@deepseek-ai/dsh/lib/bin.js; \
    install_plugin() { \
      pkg="$1"; \
      if ! /build/bundle/bin/node "$CLI" plugin --profile web add --config.minimum-release-age=0 "$pkg"; then \
        /build/bundle/bin/node "$CLI" plugin --profile web approve-builds --all; \
        /build/bundle/bin/node "$CLI" plugin --profile web add --config.minimum-release-age=0 "$pkg"; \
      fi; \
    }; \
    install_plugin "@linxin666/dsh-web-ui-all@${DSH_WEBUI_VERSION}"; \
    while IFS= read -r pkg; do \
      pkg="$(printf '%s' "$pkg" | sed 's/#.*//' | xargs)"; \
      [ -z "$pkg" ] || install_plugin "$pkg"; \
    done < /tmp/extra-plugins.txt

RUN set -eux; \
    WEBUI_COMMIT="$(git ls-remote https://github.com/zhu1090093659/dsh-web-ui.git refs/heads/dev | cut -f1)"; \
    { \
      echo "Built at (UTC): $(date -u +'%Y-%m-%dT%H:%M:%SZ')"; \
      echo "Target: linux-${TARGETARCH} (glibc >= 2.31)"; \
      echo "Node: $(/build/bundle/bin/node --version)"; \
      echo "pnpm: $(pnpm --version)"; \
      echo "DeepSeek Harness: ${DSH_VERSION}"; \
      echo "dsh-web-ui repository: https://github.com/zhu1090093659/dsh-web-ui.git"; \
      echo "dsh-web-ui dev commit: ${WEBUI_COMMIT}"; \
      echo "dsh-web-ui aggregate package: @linxin666/dsh-web-ui-all@${DSH_WEBUI_VERSION}"; \
      echo "Credentials embedded: none"; \
    } > /build/bundle/BUILD-INFO.txt; \
    file /build/bundle/bin/node; \
    /build/bundle/verify.sh

RUN set -eux; \
    DSH_HOST=127.0.0.1 DSH_PORT=13080 DSH_WORKSPACE=/build \
      /build/bundle/start.sh >/tmp/dsh-smoke.log 2>&1 & \
    pid=$!; \
    ok=0; \
    for i in $(seq 1 45); do \
      if curl --fail --silent http://127.0.0.1:13080/ >/tmp/dsh-index.html; then ok=1; break; fi; \
      if ! kill -0 "$pid" 2>/dev/null; then break; fi; \
      sleep 2; \
    done; \
    cat /tmp/dsh-smoke.log; \
    kill "$pid" 2>/dev/null || true; \
    wait "$pid" 2>/dev/null || true; \
    [ "$ok" -eq 1 ]; \
    grep -q '<title>DeepSeek Harness</title>' /tmp/dsh-index.html; \
    ! grep -q 'Failed to load plugins' /tmp/dsh-smoke.log

FROM scratch AS export
COPY --from=builder /build/bundle /
